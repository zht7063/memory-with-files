$ mwf install --host claude --dry-run
would install mwf for Claude Code (dry run: nothing was written)
hooks: [HOME]/.claude/settings.json: updated
  SessionStart: added
  UserPromptSubmit: added
  Stop: added
  PreToolUse: added
skill: [HOME]/.claude/skills/mwf
  SKILL.md: created
  references/commands.md: created
hook command: mwf
note: the hooks do nothing in a project until `mwf init` creates its .mwf/
[exit 0]

--- ~/.claude/settings.json
{
  "model": "opus",
  "permissions": {"allow": ["Bash(npm test)"]},
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done"
          }
        ]
      }
    ]
  }
}

$ mwf install --host claude
installed mwf for Claude Code
hooks: [HOME]/.claude/settings.json: updated (backup: [HOME]/.claude/settings.json.mwf-bak-[TIME])
  SessionStart: added
  UserPromptSubmit: added
  Stop: added
  PreToolUse: added
skill: [HOME]/.claude/skills/mwf
  SKILL.md: created
  references/commands.md: created
hook command: mwf
note: the hooks do nothing in a project until `mwf init` creates its .mwf/
[exit 0]

--- ~/.claude/settings.json
{
  "model": "opus",
  "permissions": {"allow": ["Bash(npm test)"]},
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "say done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "mwf hook stop --host claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mwf hook session-start --host claude",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mwf hook prompt --host claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "mwf hook pre-tool --host claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

