$ mwf install --host antigravity --json
{"ok":true,"data":{"action":"install","host":"antigravity","dry_run":false,"command":"mwf","hooks":{"path":"[HOME]/.gemini/config/plugins/mwf/hooks.json","status":"created","backup":null,"events":{"SessionStart":"added","PreInvocation":"added","Stop":"added","PreToolUse":"added"}},"plugin":{"path":"[HOME]/.gemini/config/plugins/mwf/plugin.json","status":"created","backup":null},"skill":{"dir":"[HOME]/.agents/skills/mwf","files":[{"path":"SKILL.md","status":"created","backup":null},{"path":"references/commands.md","status":"created","backup":null}]},"notes":["Antigravity blocks file edits and shell commands when a PreToolUse hook fails: run `mwf uninstall --host antigravity` before you remove or move mwf","the hooks do nothing in a project until `mwf init` creates its .mwf/"]}}
[exit 0]

--- ~/.gemini/config/plugins/mwf/plugin.json
{
  "name": "mwf",
  "displayName": "mwf",
  "version": "2.1.0",
  "description": "Project wiki memory: brings relevant .mwf/ pages into the session and keeps agents from editing .mwf/ directly."
}

--- ~/.gemini/config/plugins/mwf/hooks.json
{
  "mwf": {
    "SessionStart": [
      {
        "type": "command",
        "command": "mwf hook session-start --host antigravity",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "mwf hook prompt --host antigravity",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "mwf hook stop --host antigravity",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "mwf hook pre-tool --host antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

