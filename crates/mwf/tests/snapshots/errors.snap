{"ok":false,"error":{"code":"USAGE","message":"the following required arguments were not provided:\n  --type <TYPE>\n  --title <TITLE>\n  --summary <SUMMARY>\n\nUsage: mwf new --type <TYPE> --title <TITLE> --summary <SUMMARY> <SLUG>\n\nFor more information, try '--help'."}}
[exit 2]

$ mwf list --status gone --json
{"ok":false,"error":{"code":"USAGE","message":"invalid value 'gone' for '--status <STATUS>'\n  [possible values: active, archived, all]\n\nFor more information, try '--help'."}}
[exit 2]

