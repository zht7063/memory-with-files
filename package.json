{
  "name": "@zht7063/mwf",
  "version": "1.0.0-alpha.0",
  "description": "Project-local file memory (v1 rewrite): layered core, CLI, MCP and hooks",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"tests/**/*.test.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" package.json \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" package.json \"tsconfig*.json\""
  },
  "dependencies": {
    "@iarna/toml": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
